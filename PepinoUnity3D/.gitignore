# ===============================
# UNITY GENERATED FILES
# ===============================
# IMPORTANTE: Library/ contiene TODO el caché de Unity
# Nunca debe subirse (puede pesar varios GB)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
