# Unity cache and temp files
*.stackdump
*.log
*.tmp

# Unity Auto-generated files
*.autosave
InitTestScene*.unity

# Unity3D generated meta files (SOLO para archivos binarios, NO borrar .meta de scripts)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Unity Player Settings (caché local, puede variar por máquina)
ProjectSettings/ProjectVersion.txt
ProjectSettings/Packages/*.json

# Unity Analytics
UnityAnalyticsManager

