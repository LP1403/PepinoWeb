# ===============================
# UNITY PROJECT (UnityProject/PepinoUnity3D/)
# Nota: NO ignoramos *.dll a nivel global porque los paquetes
# SignalR vendorizados por NuGetForUnity viven bajo
# UnityProject/PepinoUnity3D/Assets/Packages/**/*.dll y SÍ se commitean.
# ===============================
# Unity Generated (carpetas regenerables por el Editor)
UnityProject/PepinoUnity3D/[Ll]ibrary/
UnityProject/PepinoUnity3D/[Tt]emp/
UnityProject/PepinoUnity3D/[Oo]bj/
UnityProject/PepinoUnity3D/[Bb]uild/
UnityProject/PepinoUnity3D/[Bb]uilds/
UnityProject/PepinoUnity3D/[Ll]ogs/
UnityProject/PepinoUnity3D/[Uu]ser[Ss]ettings/
UnityProject/PepinoUnity3D/[Uu]ser[Pp]rojectSettings/
UnityProject/PepinoUnity3D/[Mm]emoryCaptures/
UnityProject/PepinoUnity3D/[Rr]ecordings/
UnityProject/PepinoUnity3D/[Aa]uto[Bb]uild/
UnityProject/PepinoUnity3D/AssetStoreTools*/
UnityProject/PepinoUnity3D/exportedObj/

# Nota: UnityProject/PepinoUnity3D/Packages/ contiene paquetes NuGet
# vendorizados por NuGetForUnity (.nupkg, dlls, etc.) - se commitean a propósito.
# Los paquetes UPM (com.unity.*) se resuelven en Library/PackageCache (ya ignorado).

# Unity Auto-generated (proyectos IDE regenerados por Unity)
UnityProject/PepinoUnity3D/*.csproj
UnityProject/PepinoUnity3D/*.unityproj
UnityProject/PepinoUnity3D/*.sln
UnityProject/PepinoUnity3D/*.suo
UnityProject/PepinoUnity3D/*.user
UnityProject/PepinoUnity3D/*.userprefs
UnityProject/PepinoUnity3D/*.pidb
UnityProject/PepinoUnity3D/*.pidb.meta
UnityProject/PepinoUnity3D/*.booproj
UnityProject/PepinoUnity3D/*.svd
UnityProject/PepinoUnity3D/*.apk
UnityProject/PepinoUnity3D/*.aab
UnityProject/PepinoUnity3D/*.ipa
UnityProject/PepinoUnity3D/*.unitypackage
UnityProject/PepinoUnity3D/crashlytics-build.properties

# Unity Crash Reports
UnityProject/PepinoUnity3D/sysinfo.txt
UnityProject/PepinoUnity3D/*.stackdump

